      "name": "01. Autentikasi & Keamanan Akun",
      "item": [
        {
          "name": "TC-00 Get CSRF Token (Jalankan Dulu Jika 419)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const m1 = html.match(/name=\"_token\"\\s+value=\"([^\"]+)\"/);",
                  "const m2 = html.match(/<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\"/);",
                  "const token = (m1 && m1[1]) || (m2 && m2[1]) || '';",
                  "if (token) {",
                  "    pm.collectionVariables.set('csrf_token', token);",
                  "    pm.environment.set('csrf_token', token);",
                  "}",
                  "pm.test('TC-00: CSRF token & session cookie berhasil diambil', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(token).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "TC-01 Login Username (Positif)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
